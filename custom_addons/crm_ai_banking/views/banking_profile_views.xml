<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_banking_customer_profile_list" model="ir.ui.view">
        <field name="name">crm.banking.customer.profile.list</field>
        <field name="model">crm.banking.customer.profile</field>
        <field name="arch" type="xml">
            <list string="Banking 360 Profiles">
                <field name="partner_id"/>
                <field name="total_deposit_balance"/>
                <field name="total_loan_balance"/>
                <field name="total_aum"/>
                <field name="toi_ytd"/>
                <field name="toi_12m"/>
                <field name="risk_grade"/>
                <field name="corebanking_updated_at"/>
            </list>
        </field>
    </record>

    <record id="view_banking_customer_profile_form" model="ir.ui.view">
        <field name="name">crm.banking.customer.profile.form</field>
        <field name="model">crm.banking.customer.profile</field>
        <field name="arch" type="xml">
            <form string="Banking 360 Profile">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="currency_id"/>
                        <field name="corebanking_updated_at"/>
                    </group>
                    <group>
                        <group string="Tài chính">
                            <field name="total_deposit_balance"/>
                            <field name="total_loan_balance"/>
                            <field name="total_aum"/>
                            <field name="total_limit"/>
                            <field name="collateral_value"/>
                            <field name="casa_balance"/>
                        </group>
                        <group string="TOI / Risk">
                            <field name="toi_mtd"/>
                            <field name="toi_ytd"/>
                            <field name="toi_12m"/>
                            <field name="risk_score"/>
                            <field name="risk_grade"/>
                            <field name="kyc_status"/>
                            <field name="risk_level"/>
                        </group>
                    </group>
                    <group string="Quan hệ">
                        <field name="branch_code"/>
                        <field name="branch_name"/>
                        <field name="rm_code"/>
                        <field name="rm_name"/>
                        <field name="preferred_channel"/>
                        <field name="digital_adoption_level"/>
                    </group>
                    <field name="raw_summary_json"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_banking_product_holding_list" model="ir.ui.view">
        <field name="name">crm.banking.product.holding.list</field>
        <field name="model">crm.banking.product.holding</field>
        <field name="arch" type="xml">
            <list string="Banking Product Holdings" decoration-muted="status != 'active'">
                <field name="partner_id"/>
                <field name="product_category"/>
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="masked_account_number"/>
                <field name="current_balance"/>
                <field name="outstanding_balance"/>
                <field name="credit_limit"/>
                <field name="toi_ytd"/>
                <field name="status" widget="badge"/>
                <field name="corebanking_updated_at"/>
            </list>
        </field>
    </record>

    <record id="view_banking_product_holding_form" model="ir.ui.view">
        <field name="name">crm.banking.product.holding.form</field>
        <field name="model">crm.banking.product.holding</field>
        <field name="arch" type="xml">
            <form string="Banking Product Holding">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="source_system"/>
                            <field name="source_ref"/>
                            <field name="masked_account_number"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="product_category"/>
                            <field name="product_code"/>
                            <field name="product_name"/>
                            <field name="currency_id"/>
                            <field name="corebanking_updated_at"/>
                        </group>
                    </group>
                    <group>
                        <group string="Số dư / Dư nợ">
                            <field name="current_balance"/>
                            <field name="outstanding_balance"/>
                            <field name="credit_limit"/>
                            <field name="open_date"/>
                            <field name="maturity_date"/>
                        </group>
                        <group string="TOI">
                            <field name="toi_mtd"/>
                            <field name="toi_ytd"/>
                            <field name="toi_12m"/>
                        </group>
                    </group>
                    <field name="raw_holding_json"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_banking_customer_profile" model="ir.actions.act_window">
        <field name="name">Banking 360 Profiles</field>
        <field name="res_model">crm.banking.customer.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_banking_product_holding" model="ir.actions.act_window">
        <field name="name">Sản phẩm đang sử dụng</field>
        <field name="res_model">crm.banking.product.holding</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
