<odoo>
    <record id="view_crm_ai_document_list" model="ir.ui.view">
        <field name="name">crm.ai.document.list</field>
        <field name="model">crm.ai.document</field>
        <field name="arch" type="xml">
            <list string="Tài liệu AI" decoration-success="processing_status == 'done'"
                  decoration-warning="processing_status == 'processing'"
                  decoration-danger="processing_status == 'error'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="year"/>
                <field name="lead_id"/>
                <field name="attachment_name"/>
                <field name="processing_status" widget="badge"/>
                <field name="create_date"/>
                <button name="action_analyze" string="Phân tích AI" type="object"
                        icon="fa-magic"
                        invisible="processing_status in ('done', 'processing')"/>
            </list>
        </field>
    </record>

    <record id="view_crm_ai_document_form" model="ir.ui.view">
        <field name="name">crm.ai.document.form</field>
        <field name="model">crm.ai.document</field>
        <field name="arch" type="xml">
            <form string="Phân tích tài liệu AI">
                <header>
                    <button name="action_analyze" string="🔍 Phân tích AI" type="object"
                            class="btn-primary"
                            invisible="processing_status == 'processing'"/>
                    <field name="processing_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin tài liệu">
                            <field name="lead_id"/>
                            <field name="document_type"/>
                            <field name="year"/>
                            <field name="attachment_id" widget="many2one"/>
                        </group>
                        <group string="Trạng thái">
                            <field name="processing_status" widget="badge"/>
                            <field name="error_message" invisible="processing_status != 'error'"
                                   string="Lỗi" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kết quả AI">
                            <field name="ai_analysis_html" readonly="1" widget="html"
                                   nolabel="1"/>
                        </page>
                        <page string="Văn bản OCR thô">
                            <field name="ocr_raw_text" widget="text" readonly="1" nolabel="1"
                                   placeholder="Văn bản trích xuất từ tài liệu sẽ hiển thị ở đây..."/>
                        </page>
                    </notebook>
                    <!-- Drag-and-drop attachment area -->
                    <field name="attachment_id" widget="binary" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_crm_ai_document" model="ir.actions.act_window">
        <field name="name">Tài liệu AI</field>
        <field name="res_model">crm.ai.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
