<odoo>
    <record id="view_crm_ai_coaching_report_list" model="ir.ui.view">
        <field name="name">crm.ai.coaching.report.list</field>
        <field name="model">crm.ai.coaching.report</field>
        <field name="arch" type="xml">
            <list string="Báo cáo Sales Coach" decoration-success="score_overall &gt;= 7"
                  decoration-warning="score_overall &gt;= 5 and score_overall &lt; 7"
                  decoration-danger="score_overall &lt; 5 and score_overall &gt; 0">
                <field name="report_date"/>
                <field name="user_id"/>
                <field name="call_session_id"/>
                <field name="lead_id"/>
                <field name="score_opening" string="Chào hỏi"/>
                <field name="score_needs_discovery" string="Khám phá"/>
                <field name="score_product_fit" string="SP"/>
                <field name="score_objection" string="Từ chối"/>
                <field name="score_closing" string="Chốt"/>
                <field name="score_overall" string="Tổng" widget="progressbar"
                       options="{'max_value': 10}"/>
                <field name="processing_status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_crm_ai_coaching_report_form" model="ir.ui.view">
        <field name="name">crm.ai.coaching.report.form</field>
        <field name="model">crm.ai.coaching.report</field>
        <field name="arch" type="xml">
            <form string="AI Sales Coach Report">
                <header>
                    <button name="action_generate_coaching" string="🤖 Phân tích AI" type="object"
                            class="btn-primary"
                            invisible="processing_status != 'draft'"/>
                    <field name="processing_status" widget="statusbar"
                           statusbar_visible="draft,processing,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Thông tin">
                            <field name="call_session_id"/>
                            <field name="user_id"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="report_date"/>
                            <field name="visible_to_user"/>
                        </group>
                        <group string="Điểm số">
                            <field name="score_opening"/>
                            <field name="score_needs_discovery"/>
                            <field name="score_product_fit"/>
                            <field name="score_objection"/>
                            <field name="score_closing"/>
                            <field name="score_overall" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="📊 Báo cáo chi tiết">
                            <field name="coaching_html" readonly="1" widget="html" nolabel="1"/>
                        </page>
                        <page string="Raw JSON">
                            <group>
                                <field name="strengths_json" string="Điểm mạnh"/>
                                <field name="improvements_json" string="Cần cải thiện"/>
                                <field name="missed_opportunities_json" string="Cơ hội bỏ lỡ"/>
                                <field name="key_moments_json" string="Khoảnh khắc quan trọng"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_ai_coaching_report" model="ir.actions.act_window">
        <field name="name">Báo cáo Sales Coach</field>
        <field name="res_model">crm.ai.coaching.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
