<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_document_checklist_template_form" model="ir.ui.view">
        <field name="name">crm.document.checklist.template.form</field>
        <field name="model">crm.document.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Template Checklist Hồ sơ">
                <sheet>
                    <group>
                        <field name="product_type"/>
                        <field name="remind_after_days"/>
                        <field name="active"/>
                    </group>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="required"/>
                            <field name="file_format_hint"/>
                            <field name="description"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_document_checklist_template_list" model="ir.ui.view">
        <field name="name">crm.document.checklist.template.list</field>
        <field name="model">crm.document.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Templates Checklist">
                <field name="product_type"/>
                <field name="item_count" string="Số giấy tờ"/>
                <field name="remind_after_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_crm_document_checklist_template" model="ir.actions.act_window">
        <field name="name">Templates Hồ sơ</field>
        <field name="res_model">crm.document.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Checklist form (per lead) -->
    <record id="crm_document_checklist_form" model="ir.ui.view">
        <field name="name">crm.document.checklist.form</field>
        <field name="model">crm.document.checklist</field>
        <field name="arch" type="xml">
            <form string="Checklist Hồ sơ">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="display_name" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="product_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="completion_rate" widget="progressbar"/>
                            <field name="pending_count" string="Còn thiếu"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" decoration-success="status == 'approved'"
                              decoration-warning="status == 'submitted'"
                              decoration-danger="status == 'rejected'"
                              decoration-muted="status == 'pending'">
                            <field name="sequence" widget="handle"/>
                            <field name="item_name"/>
                            <field name="required"/>
                            <field name="status"/>
                            <field name="submitted_date"/>
                            <field name="attachment_id" widget="many2one_avatar"/>
                            <field name="note"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
