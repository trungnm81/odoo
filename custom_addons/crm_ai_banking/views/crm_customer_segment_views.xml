<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_customer_segment_list" model="ir.ui.view">
        <field name="name">crm.customer.segment.list</field>
        <field name="model">crm.customer.segment</field>
        <field name="arch" type="xml">
            <list string="Customer Segments" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="customer_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_crm_customer_segment_form" model="ir.ui.view">
        <field name="name">crm.customer.segment.form</field>
        <field name="model">crm.customer.segment</field>
        <field name="arch" type="xml">
            <form string="Customer Segment">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="customer_type"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Mô tả tiêu chí phân khúc, ví dụ: doanh thu, AUM, quy mô doanh nghiệp..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_customer_segment_search" model="ir.ui.view">
        <field name="name">crm.customer.segment.search</field>
        <field name="model">crm.customer.segment</field>
        <field name="arch" type="xml">
            <search string="Customer Segments">
                <field name="name"/>
                <field name="code"/>
                <field name="customer_type"/>
                <filter name="individual" string="Cá nhân" domain="[('customer_type', '=', 'individual')]"/>
                <filter name="business" string="Doanh nghiệp" domain="[('customer_type', '=', 'business')]"/>
                <filter name="inactive" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_customer_type" string="Nhóm theo loại khách hàng" context="{'group_by': 'customer_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_crm_customer_segment" model="ir.actions.act_window">
        <field name="name">Customer Segments</field>
        <field name="res_model">crm.customer.segment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_customer_segment_search"/>
        <field name="context">{'search_default_group_customer_type': 1}</field>
    </record>

</odoo>
