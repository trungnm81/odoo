        <field name="nextcall">2026-05-31 00:30:00</field>
        <field name="active">True</field>
    </record>

    <!-- Loan Repayment Alert: chạy hàng tuần thứ Hai -->
    <record id="ir_cron_crm_ai_loan_repayment" model="ir.cron">
        <field name="name">CRM AI: Loan Repayment Follow-up</field>
        <field name="model_id" search="[('model','=','crm.lead')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_loan_repayment_alert()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-06-02 01:00:00</field>
        <field name="active">True</field>
    </record>

    <!-- Core Banking staging processor: xử lý các batch daily đã nạp vào CRM -->
    <record id="ir_cron_corebanking_daily_staging" model="ir.cron">
        <field name="name">CRM AI: Core Banking Daily Staging Sync</field>
        <field name="model_id" search="[('model','=','crm.corebanking.customer.batch')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_daily_staging()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-05-30 18:00:00</field>
        <field name="active">True</field>
    </record>

</odoo>
