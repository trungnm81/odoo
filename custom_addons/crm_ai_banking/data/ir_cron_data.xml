<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Daily Digest: chạy lúc 8:00 sáng mỗi ngày -->
    <record id="ir_cron_crm_ai_daily_digest" model="ir.cron">
        <field name="name">CRM AI: Daily Digest</field>
        <field name="model_id" search="[('model','=','crm.lead')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_daily_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-05-30 01:00:00</field>
        <field name="active">True</field>
    </record>

    <!-- Cold Lead Alert: chạy lúc 9:00 sáng mỗi ngày -->
    <record id="ir_cron_crm_ai_cold_lead_alert" model="ir.cron">
        <field name="name">CRM AI: Cold Lead Alert</field>
        <field name="model_id" search="[('model','=','crm.lead')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_cold_lead_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-05-30 02:00:00</field>
        <field name="active">True</field>
    </record>

    <!-- Large Deal Alert: chạy lúc 9:30 sáng mỗi ngày -->
    <record id="ir_cron_crm_ai_large_deal_alert" model="ir.cron">
        <field name="name">CRM AI: Large Deal Alert</field>
        <field name="model_id" search="[('model','=','crm.lead')]"/>
