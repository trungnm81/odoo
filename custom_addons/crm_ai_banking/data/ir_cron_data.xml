        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-05-30 02:30:00</field>
        <field name="active">True</field>
    </record>


    <!-- NBA Refresh: chạy hàng ngày để cập nhật Next Best Action -->
    <record id="ir_cron_crm_ai_nba_refresh" model="ir.cron">
        <field name="name">CRM AI: Refresh NBA (Next Best Action)</field>
        <field name="model_id" search="[('model','=','crm.lead')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_nba()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-05-30 03:00:00</field>
        <field name="active">True</field>
    </record>

    <!-- Birthday Activities: chạy 7:00 sáng mỗi ngày -->
    <record id="ir_cron_crm_ai_birthday_activities" model="ir.cron">
        <field name="name">CRM AI: Birthday Activity Reminder</field>
        <field name="model_id" search="[('model','=','crm.lead')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_birthday_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-05-31 00:00:00</field>
        <field name="active">True</field>
    </record>

    <!-- Deposit Maturity Alert: chạy 7:30 sáng mỗi ngày -->
    <record id="ir_cron_crm_ai_deposit_maturity" model="ir.cron">
        <field name="name">CRM AI: Deposit Maturity Alert</field>
        <field name="model_id" search="[('model','=','crm.lead')]"/>
